{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false
  },
  "include": ["cliEnhancements.js", "browserProviders.js", "scraper.js"],
  "exclude": ["node_modules", "test-results", "scripts", "playwright-cli.js", "skillCheck.js"]
}
